[Unit]
Description=Calibre Web (beta / ui-rewrite review)
After=network.target

[Service]
Type=simple
User=calibreweb
Group=calibreweb
WorkingDirectory=/opt/calibre-web-beta
Environment=CALIBRE_DBPATH=/opt/calibre-web-beta
Environment=CALIBRE_PORT=8085
ExecStart=/opt/calibre-web-beta/venv/bin/cps -i 127.0.0.1
Restart=always
RestartSec=5
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
